# File cấu hình cho máy local. Sao chép thành .env rồi điền giá trị thật.
# Không đưa .env lên GitHub. Trên Render không dùng file này (xem render.yaml).

# MySQL trên máy
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hotel_management
DB_USER=hotel_app
DB_PASSWORD=change_this_password

# Múi giờ của phiên MySQL (giờ Việt Nam)
DB_TIME_ZONE=+07:00

# Tạo chuỗi ngẫu nhiên:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace_with_a_long_random_secret_key
JWT_EXPIRE_MINUTES=120

# Không bắt buộc:
# DATABASE_URL=   chuỗi mysql://... ; nếu có, ghi đè DB_HOST, DB_PORT, DB_USER, DB_PASSWORD
# DB_SSL_CA=      đường dẫn chứng chỉ CA; để trống thì tự dùng certs/ca.pem khi database không ở máy này
# SITE_URL=       địa chỉ website; để trống thì tự lấy theo địa chỉ đang truy cập
